<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;netstandard2.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Tc66Serial</RootNamespace>
    <AssemblyName>Tc66Serial</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <!-- NuGet package metadata -->
    <PackageId>Tc66Serial</PackageId>
    <Version>0.1.0</Version>
    <Authors>savrcbl</Authors>
    <Description>A .NET library for reading live measurements (voltage, current, power, resistance, D+/D- voltage, mAh/mWh counters) from Ruideng TC66 and TC66C USB power meters over a serial connection.</Description>
    <PackageTags>tc66;tc66c;usb;power-meter;serialport;ruideng;electronics</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/savrcbl/tc66-serial</RepositoryUrl>
    <PackageProjectUrl>https://github.com/savrcbl/tc66-serial</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" Condition="Exists('README.md')" />
  </ItemGroup>

</Project>
